generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteProfile {
  id              String   @id @default("main")
  brandName       String   @default("shizuku")
  brandKanji      String   @default("雫")
  fullName        String
  headlineEn      String
  headlineId      String
  rolesJson       String
  bioEn           String
  bioId           String
  aboutStoryEn    String
  aboutStoryId    String
  location        String   @default("Jakarta, Indonesia")
  currentRoleEn   String
  currentRoleId   String
  currentOrg      String
  availabilityEn  String
  availabilityId  String
  currentlyEn     String
  currentlyId     String
  heroImage       String   @default("")
  heroImageMobile String   @default("")
  avatarImage     String   @default("/assets/avatar-rainy.jpg")
  email           String
  linkedinUrl     String   @default("")
  githubUrl       String   @default("")
  instagramUrl    String   @default("")
  youtubeUrl      String   @default("")
  resumeUrl       String   @default("")
  statsJson       String
  pillarsJson     String
  updatedAt       DateTime @updatedAt
}

model WorkspaceApp {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("APP")
  descriptionEn String
  descriptionId String
  url           String
  icon          String   @default("sparkles")
  badge         String   @default("")
  isExternal    Boolean  @default(false)
  published     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

model Project {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  category       String   @default("FULLSTACK")
  year           String
  status         String   @default("PRODUCTION")
  roleEn         String
  roleId         String
  summaryEn      String
  summaryId      String
  descriptionEn  String
  descriptionId  String
  highlightsJson String   @default("[]")
  impactMetricEn String   @default("")
  impactMetricId String   @default("")
  techStackJson  String   @default("[]")
  coverImage     String   @default("/assets/cover-platform.jpg")
  liveUrl        String   @default("")
  repoUrl        String   @default("")
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, featured, sortOrder])
}

model Experience {
  id           String   @id @default(cuid())
  kind         String   @default("WORK")
  organization String
  roleEn       String
  roleId       String
  location     String   @default("Jakarta, ID")
  periodEn     String
  periodId     String
  isCurrent    Boolean  @default(false)
  summaryEn    String
  summaryId    String
  bulletsJson  String   @default("{\"en\":[],\"id\":[]}")
  tagsJson     String   @default("[]")
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, kind, sortOrder])
}

model Certificate {
  id            String   @id @default(cuid())
  titleEn       String
  titleId       String
  issuer        String
  category      String   @default("SOFTWARE ENG")
  issuedDate    String
  credentialId  String   @default("")
  credentialUrl String   @default("")
  imageUrl      String   @default("")
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, featured, sortOrder])
}

model SkillGroup {
  id        String   @id @default(cuid())
  nameEn    String
  nameId    String
  itemsJson String   @default("[]")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ============================================================================
// SHIZUKU ECOSYSTEM (Isolated from Portfolio CMS models)
// 1 shared identity (`EcosystemUser`) for SHIZUKU, SHIKAS & upcoming apps
// ============================================================================

model EcosystemUser {
  id             String              @id @default(cuid())
  email          String              @unique
  displayName    String
  passwordHash   String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  shikasEntries  ShikasTransaction[]
  shikasSettings ShikasSettings?
}

model ShikasTransaction {
  id          String
  userId      String
  user        EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  date        String
  amountIdr   Int
  categoryId  String
  note        String
  merchant    String?
  accountId   String?
  toAccountId String?
  feeIdr      Int           @default(0)
  createdAt   String

  @@id([userId, id])
  @@index([userId, date])
}

model ShikasSettings {
  userId        String        @id
  user          EcosystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale        String        @default("en")
  privacyMode   Boolean       @default(false)
  rainEnabled   Boolean       @default(true)
  cycleStartDay Int           @default(1)
  accountsJson  String        @default("[]")
  updatedAt     DateTime      @updatedAt
}
