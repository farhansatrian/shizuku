# =============================================================================
# shizuku (雫) — Production Environment Template for VM
# Copy to .env.production on your VM and fill in secure secrets
# =============================================================================

SHIZUKU_IMAGE="ghcr.io/farhansatrian/shizuku:latest"

# Bind address & host port on VM (change APP_PORT if 3000 is already used)
APP_BIND_IP="0.0.0.0"
APP_PORT="3000"

# Generate strong secret via: openssl rand -hex 32
AUTH_SECRET="replace-with-openssl-rand-hex-32-output"

# Initial Admin Studio credentials (only used on first empty DB boot)
ADMIN_USERNAME="farhan"
ADMIN_EMAIL="farhansatria.07@gmail.com"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# Use "true" when served behind HTTPS domain; "false" only for raw HTTP testing
COOKIE_SECURE="true"

# SHIZUKU Ecosystem SSO & CORS (add your SHIKAS & upcoming app public origins)
ECOSYSTEM_ALLOWED_ORIGINS="https://shikas.yourdomain.dev"
# Optional: set shared parent domain (with leading dot) for instant cross-subdomain login
ECOSYSTEM_COOKIE_DOMAIN=""
