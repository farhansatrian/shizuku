# =============================================================================
# shizuku (雫) — Environment Configuration Example
# Copy to .env for local development or .env.production for VM deployment
# =============================================================================

# SQLite database location (relative to prisma/ or absolute path in Docker)
DATABASE_URL="file:../data/shizuku.db"

# Directory for persistent Admin CMS media uploads
UPLOAD_DIR="./data/uploads"

# JWT session secret for /admin authentication (use at least 32 random chars in prod!)
AUTH_SECRET="change-me-to-a-long-random-secret-key-at-least-32-chars"

# Initial Admin credentials (used by prisma/seed.ts on first boot)
ADMIN_USERNAME="farhan"
ADMIN_EMAIL="farhansatria.07@gmail.com"
ADMIN_PASSWORD="ChangeMe123!"

# Set to "true" when served behind HTTPS (production VM), "false" on local http://localhost
COOKIE_SECURE="false"

# App port (used by compose.prod.yaml)
APP_PORT="3000"
APP_BIND_IP="0.0.0.0"
